    function renderDayTasks() {
      const list = document.getElementById("dayTaskList");
      const dayObj = dayLabels.find(d => d.k === selectedDayKey);
      document.getElementById("dayTasksHeading").textContent =
        selectedDayKey === todayKey ? "✅ Päivän tehtävät (Tänään)" : `✅ Päivän tehtävät (${dayObj ? dayObj.n : ""})`;

      const tasks = state.dayTasks[selectedDayKey] || [];
      list.innerHTML = "";

      if (tasks.length === 0) {
