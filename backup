    function stepProgressiveBreath() {
      if (!breathingActive) return;
      const sphere = document.getElementById("breathSphere");
      const mainTxt = document.getElementById("breathMainText");
      const subTxt = document.getElementById("breathSubText");

      const sec = BREATH_STEPS[Math.min(breathCycleIdx, BREATH_STEPS.length - 1)];
      sphere.style.transitionDuration = `${sec}s`;

      if (breathInhale) {
        sphere.classList.remove("exhale");
        sphere.classList.add("inhale");
        mainTxt.textContent = "Sisään";
        subTxt.textContent = `${sec} s`;
        playTone(440, 0.14);
        breathInhale = false;
      } else {
        sphere.classList.remove("inhale");
        sphere.classList.add("exhale");
        mainTxt.textContent = "Ulos";
        subTxt.textContent = `${sec} s`;
        playTone(360, 0.14);
        breathInhale = true;
        breathCycleIdx++;
      }

      breathTimeout = setTimeout(stepProgressiveBreath, sec * 1000);
    }

