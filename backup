    // =========================================================================
    // 10. TAB 1: ⚡ TEOT (START-TO-FINISH SEQUENCES, OUTING TRAIL, PICTURE CARDS)
    // =========================================================================
    function getSeqRecord(seqId, len) {
      if (!state.seqProgress[seqId] || !Array.isArray(state.seqProgress[seqId].done)) {
        state.seqProgress[seqId] = {
          done: new Array(len).fill(false),
          lastColorIdx: -1
        };
      }
      return state.seqProgress[seqId];
    }

    function renderStartToFinishSequences() {
      const seq = ACTION_SEQUENCES.find(s => s.id === state.activeSeqId) || ACTION_SEQUENCES[0];
      const rec = getSeqRecord(seq.id, seq.steps.length);

      document.getElementById("seqChainPills").innerHTML = ACTION_SEQUENCES.map(s =>
        `<button type="button" class="filter-pill ${s.id === seq.id ? "active" : ""}" onclick="selectActionSeq('${s.id}', event)">${s.label}</button>`
      ).join("");

      const doneCount = rec.done.filter(Boolean).length;
      const pct = Math.round((doneCount / seq.steps.length) * 100);
      document.getElementById("seqProgressFill").style.width = pct + "%";

      const firstUndoneIdx = rec.done.findIndex(d => !d);
      const track = document.getElementById("seqCardsTrack");
      track.innerHTML = "";

      seq.steps.forEach((step, idx) => {
        const isLast = idx === seq.steps.length - 1;
        const isDone = !!rec.done[idx];
        const isNext = idx === firstUndoneIdx;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "seq-pic-card"
          + (isDone && !isLast ? " step-done" : "")
          + (isNext ? " next-up" : "")
          + (isLast ? " is-last" : "")
          + (isLast && rec.lastColorIdx >= 0 ? " last-colored" : "");

        if (isLast && rec.lastColorIdx >= 0) {
          const theme = LAST_CARD_COLOR_THEMES[rec.lastColorIdx % LAST_CARD_COLOR_THEMES.length];
          btn.style.backgroundColor = theme.bg;
          btn.style.borderColor = theme.border;
          btn.style.color = theme.text;
        }

        const roleLabel = idx === 0
          ? "1. Alku"
          : isLast
          ? `${idx + 1}. Loppu 🏁`
          : `${idx + 1}. Vaihe`;

        const statusBadge = isLast && rec.lastColorIdx >= 0
          ? `<span>🎨 ${LAST_CARD_COLOR_THEMES[rec.lastColorIdx % LAST_CARD_COLOR_THEMES.length].name}</span>`
          : isDone
          ? `<span>✓</span>`
          : isLast
          ? `<span class="coin">${Math.max(15, seq.totalPts - (seq.steps.length - 1) * 5)}</span>`
          : `<span class="coin">5</span>`;

        btn.innerHTML = `
          <div class="seq-step-badge">
            <span>${roleLabel}</span>
            ${statusBadge}
          </div>
          <div class="seq-pic-card-svg">${getComicSVG(step.scene, isDone)}</div>
          <div class="seq-pic-card-label">${escapeHtml(step.title)}</div>
        `;

        btn.onclick = (e) => {
          if (isLast) {
            const wasDone = rec.done[idx];
            rec.done[idx] = true;
            rec.lastColorIdx = (rec.lastColorIdx + 1) % LAST_CARD_COLOR_THEMES.length;
            saveState();
            renderStartToFinishSequences();

            const theme = LAST_CARD_COLOR_THEMES[rec.lastColorIdx];
            if (!wasDone) {
              const finishPts = Math.max(15, seq.totalPts - (seq.steps.length - 1) * 5);
              addPoints(finishPts, `Koko ketju valmis! (${theme.name})`, e);
              triggerJoyfulTailWag(null, false);
            } else {
              playTone(680, 0.14);
              showToast(`Viimeisen kortin väri: ${theme.name}`);
            }
          } else {
            rec.done[idx] = !rec.done[idx];
            saveState();
            renderStartToFinishSequences();
            if (rec.done[idx]) {
              addPoints(5, null, e);
            }
          }
        };

        track.appendChild(btn);
      });
    }

