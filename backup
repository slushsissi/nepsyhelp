    // Freehand Drawing Canvas
    const moodCanvas = document.getElementById("moodCanvas");
    const moodCtx = moodCanvas.getContext("2d");
    let drawing = false;
    let brushColor = "#0E8760";

    function resizeCanvas() {
      const wrap = document.getElementById("canvasWrap");
      if (!wrap || wrap.clientWidth === 0) return;
      if (moodCanvas.width !== wrap.clientWidth || moodCanvas.height !== wrap.clientHeight) {
        moodCanvas.width = wrap.clientWidth;
        moodCanvas.height = wrap.clientHeight;
        clearCanvas();
      }
    }

    function clearCanvas() {
      moodCtx.globalAlpha = 1;
      moodCtx.fillStyle = "#FFFFFF";
      moodCtx.fillRect(0, 0, moodCanvas.width, moodCanvas.height);
      canvasDirty = false;
    }

    function getPt(e) {
      const r = moodCanvas.getBoundingClientRect();
      const cx = e.touches ? e.touches[0].clientX : e.clientX;
      const cy = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: cx - r.left, y: cy - r.top };
    }

    function startStroke(e) {
      resizeCanvas();
      drawing = true;
      canvasDirty = true;
      const pt = getPt(e);
      moodCtx.lineCap = "round";
      moodCtx.lineJoin = "round";
      moodCtx.lineWidth = brushColor === "#FFFFFF" ? 24 : 13;
      moodCtx.strokeStyle = brushColor;
      moodCtx.fillStyle = brushColor;
      moodCtx.globalAlpha = brushColor === "#FFFFFF" ? 1 : 0.85;
      moodCtx.beginPath();
      moodCtx.arc(pt.x, pt.y, moodCtx.lineWidth / 2, 0, Math.PI * 2);
      moodCtx.fill();
      moodCtx.beginPath();
      moodCtx.moveTo(pt.x, pt.y);
    }

    function moveStroke(e) {
      if (!drawing) return;
      if (e.cancelable) e.preventDefault();
      const pt = getPt(e);
      moodCtx.lineTo(pt.x, pt.y);
      moodCtx.stroke();
    }

    function endStroke() { drawing = false; }

    moodCanvas.addEventListener("mousedown", startStroke);
    moodCanvas.addEventListener("mousemove", moveStroke);
    window.addEventListener("mouseup", endStroke);
    moodCanvas.addEventListener("touchstart", startStroke, { passive: false });
    moodCanvas.addEventListener("touchmove", moveStroke, { passive: false });
