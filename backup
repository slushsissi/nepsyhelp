    let audioCtx = null;
    function playTone(freq = 520, duration = 0.18, type = "sine") {
      if (!state.settings.sound) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === "suspended") audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    let rainGainNode = null;
    let rainSourceNode = null;
    let rainActive = false;

    function toggleRainSound() {
      const btn = document.getElementById("btnToggleRain");
      if (rainActive) {
        if (rainSourceNode) {
          try { rainSourceNode.stop(); } catch (e) {}
          rainSourceNode.disconnect();
        }
        rainActive = false;
        btn.textContent = "🌧️ Sateen ropina: Pois";
        return;
      }

      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === "suspended") audioCtx.resume();
        const bufferSize = 2 * audioCtx.sampleRate;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        let lastOut = 0.0;
        for (let i = 0; i < bufferSize; i++) {
          const white = Math.random() * 2 - 1;
          data[i] = (lastOut + (0.04 * white)) / 1.04;
          lastOut = data[i];
          data[i] *= 1.8;
        }
        const source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = "lowpass";
        filter.frequency.value = 420;

        const gain = audioCtx.createGain();
        gain.gain.value = 0.06;

        source.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);
        source.start(0);

        rainSourceNode = source;
        rainGainNode = gain;
        rainActive = true;
        btn.textContent = "🌧️ Sateen ropina: Päällä";
      } catch (e) {}
    }

    document.getElementById("btnToggleRain").onclick = toggleRainSound;

