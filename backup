            state.dayTasks[selectedDayKey] = state.dayTasks[selectedDayKey].filter(x => x.id !== t.id);
            saveState();
            renderDayTasks();
          };
          row.appendChild(header);

          const strip = document.createElement("div");
          strip.className = "mini-chain-strip";

          t.steps.forEach((st, sIdx) => {
            const isLast = sIdx === t.steps.length - 1;
            const cIdx = typeof t.lastColorIdx === "number" ? t.lastColorIdx : -1;
            const cardBtn = document.createElement("button");
            cardBtn.type = "button";
            cardBtn.className = "seq-pic-card"
              + (st.done && !isLast ? " step-done" : "")
              + (isLast ? " is-last" : "")
              + (isLast && cIdx >= 0 ? " last-colored" : "");

            if (isLast && cIdx >= 0) {
              const theme = LAST_CARD_COLOR_THEMES[cIdx % LAST_CARD_COLOR_THEMES.length];
              cardBtn.style.backgroundColor = theme.bg;
              cardBtn.style.borderColor = theme.border;
              cardBtn.style.color = theme.text;
            }

            cardBtn.innerHTML = `
              <div class="seq-step-badge">
                <span>${isLast ? `${sIdx + 1}. Loppu 🏁` : `${sIdx + 1}. Vaihe`}</span>
                <span>${st.done ? "✓" : ""}</span>
