<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Pesäkolo – Lempeä arjen ja mielen tuki</title>
  <style>
    :root {
      --bg: #EBF4F0;
      --surface: #FFFFFF;
      --surface-soft: #F3F8F5;
      --surface-tint: #E2F1EA;
      --text-pure: #10261C;
      --text: #1D382B;
      --text-muted: #4C685A;
      --accent: #0E8760;
      --accent-hover: #0A6C4C;
      --accent-soft: #D7F0E4;
      --amber: #C46810;
      --amber-soft: #FEF3E2;
      --blue: #0A72B5;
      --blue-soft: #E4F3FC;
      --purple: #6B4BC2;
      --purple-soft: #F0EBFC;
      --coral: #C6324B;
      --border: #C9DFD4;
      --shadow: 0 4px 16px rgba(16, 38, 28, 0.06);
      --radius-xl: 20px;
      --radius-lg: 14px;
      --radius-md: 11px;
      --radius-pill: 9999px;
    }

    body.dark {
      --bg: #111916;
      --surface: #1A2622;
      --surface-soft: #22312C;
      --surface-tint: #243730;
      --text-pure: #F2FAF6;
      --text: #E1EFE8;
      --text-muted: #9CB8AA;
      --accent: #34D399;
      --accent-hover: #6EE7B7;
      --accent-soft: rgba(52, 211, 153, 0.16);
      --amber: #FBBF24;
      --amber-soft: rgba(251, 191, 36, 0.15);
      --blue: #38BDF8;
      --blue-soft: rgba(56, 189, 248, 0.15);
      --purple: #A78BFA;
      --purple-soft: rgba(167, 139, 250, 0.16);
      --coral: #FB7185;
      --border: #2E423B;
      --shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    }

    body.reduce-motion * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 12px 12px 115px;
      overflow-x: hidden;
    }

    .app {
      width: 100%;
      max-width: 740px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* =========================================================================
       2. GOLDEN COIN BADGES
       ========================================================================= */
    .coin {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 24px;
      height: 24px;
      padding: 0 6px;
      border-radius: var(--radius-pill);
      background: radial-gradient(circle at 32% 30%, #FEF08A 0%, #F59E0B 65%, #D97706 100%);
      border: 1.5px solid #92400E;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.85), 0 1px 3px rgba(120, 53, 15, 0.28);
      color: #3B1A04;
      font-weight: 800;
      font-size: 0.74rem;
      line-height: 1;
      vertical-align: middle;
      flex-shrink: 0;
      letter-spacing: -0.02em;
    }

    .coin.coin-lg {
      min-width: 28px;
      height: 28px;
      padding: 0 8px;
      font-size: 0.84rem;
    }

    /* =========================================================================
       3. SINGLE-ROW ROUNDED PILL HEADER
       ========================================================================= */
    .top-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      background: var(--surface);
      border: 1.5px solid var(--border);
      padding: 7px 11px;
      border-radius: var(--radius-pill);
      box-shadow: var(--shadow);
      flex-wrap: nowrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .brand h1 {
      font-size: 1.08rem;
      font-weight: 800;
      color: var(--accent);
      white-space: nowrap;
      letter-spacing: -0.02em;
    }

    .companion-selector {
      display: flex;
      align-items: center;
      background: var(--surface-soft);
      border: 1px solid var(--border);
      padding: 2px;
      border-radius: var(--radius-pill);
      gap: 2px;
      flex-shrink: 1;
      min-width: 0;
    }

    .comp-btn {
      border: none;
      background: transparent;
      color: var(--text-muted);
      padding: 4px 8px;
      border-radius: var(--radius-pill);
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s, color 0.15s;
    }

    .comp-btn.active {
      background: var(--surface);
      color: var(--text-pure);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .status-badge {
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      color: var(--text-pure);
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      font-weight: 800;
      font-size: 0.8rem;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: transform 0.2s ease;
    }

    .status-badge.pop {
      transform: scale(1.12);
    }

    .settings-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1.5px solid var(--border);
      background: var(--surface-soft);
      color: var(--text);
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    @media (max-width: 440px) {
      .brand h1 { font-size: 0.98rem; }
      .comp-btn { padding: 4px 6px; font-size: 0.85rem; }
      .status-badge { font-size: 0.75rem; padding: 3px 7px; gap: 4px; }
    }

    /* =========================================================================
       4. REALITY ANCHOR CARD
       ========================================================================= */
    .reality-anchor {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-left: 5px solid var(--accent);
      border-radius: var(--radius-lg);
      padding: 11px 14px;
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .reality-content {
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex: 1;
    }

    .reality-kicker {
      font-size: 0.74rem;
      font-weight: 800;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .reality-text {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text-pure);
      line-height: 1.4;
    }

    /* =========================================================================
       5. FIVE CLEAR TOP-LEVEL TABS
       ========================================================================= */
    .nav-tabs {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      background: var(--surface);
      padding: 5px;
      border-radius: var(--radius-lg);
      border: 1.5px solid var(--border);
      box-shadow: var(--shadow);
      gap: 4px;
    }

    .tab-btn {
      border: none;
      background: transparent;
      color: var(--text-muted);
      padding: 9px 4px;
      border-radius: var(--radius-md);
      font-family: inherit;
      font-weight: 800;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.15s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      white-space: nowrap;
    }

    @media (max-width: 520px) {
      .tab-btn {
        flex-direction: column;
        gap: 2px;
        font-size: 0.72rem;
        padding: 8px 2px;
      }
    }

    .tab-btn:hover {
      background: var(--surface-soft);
      color: var(--text-pure);
    }

    .tab-btn.active {
      background: var(--accent);
      color: #FFFFFF;
    }
    body.dark .tab-btn.active {
      color: #0D1F18;
    }

    .tab-panel {
      display: none;
      flex-direction: column;
      gap: 14px;
    }
    .tab-panel.active {
      display: flex;
    }

    /* =========================================================================
       6. SHARED CARDS, BUTTONS & INPUTS
       ========================================================================= */
    .card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 16px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .card-title {
      font-size: 1.04rem;
      font-weight: 800;
      color: var(--text-pure);
    }

    .card-desc {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.45;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 5px;
    }

    .subbox {
      background: var(--surface-soft);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .btn {
      padding: 8px 14px;
      border-radius: var(--radius-pill);
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      border: 1.5px solid transparent;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: transform 0.12s ease, background 0.15s ease;
    }
    .btn:active {
      transform: scale(0.97);
    }

    .btn-primary {
      background: var(--accent);
      color: #FFFFFF;
    }
    body.dark .btn-primary {
      color: #0D1F18;
    }
    .btn-primary:hover {
      background: var(--accent-hover);
    }

    .btn-soft {
      background: var(--surface);
      color: var(--text);
      border-color: var(--border);
    }
    .btn-soft:hover {
      border-color: var(--accent);
    }

    .btn-warm {
      background: var(--amber);
      color: #FFFFFF;
    }

    input[type="text"], select, textarea {
      width: 100%;
      padding: 9px 12px;
      border-radius: var(--radius-md);
      border: 1.5px solid var(--border);
      background: var(--surface);
      color: var(--text-pure);
      font-family: inherit;
      font-size: 0.86rem;
      outline: none;
    }
    input[type="text"]:focus, select:focus, textarea:focus {
      border-color: var(--accent);
    }

    .pills-row {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .filter-pill {
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      color: var(--text-muted);
      padding: 5px 11px;
      border-radius: var(--radius-pill);
      font-size: 0.77rem;
      font-weight: 700;
      cursor: pointer;
    }
    .filter-pill.active {
      background: var(--accent);
      color: #FFFFFF;
      border-color: var(--accent);
    }
    body.dark .filter-pill.active {
      color: #0D1F18;
    }

    /* =========================================================================
       7. TAB 1: TEOT (START-TO-FINISH CARDS, OUTING TRAIL, PICTURE CARDS, TASKS)
       ========================================================================= */
    .outing-card {
      background: var(--surface-tint);
      border: 1.5px solid var(--accent);
      border-radius: var(--radius-lg);
      padding: 13px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .keys-reminder {
      background: var(--amber-soft);
      border: 1.5px solid var(--amber);
      color: var(--text-pure);
      padding: 8px 12px;
      border-radius: var(--radius-md);
      font-size: 0.83rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dest-pills {
      display: flex;
      gap: 4px;
      background: var(--surface);
      padding: 3px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border);
      flex-wrap: wrap;
    }

    .dest-btn {
      border: none;
      background: transparent;
      color: var(--text-muted);
      padding: 4px 10px;
      border-radius: var(--radius-pill);
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
    }
    .dest-btn.active {
      background: var(--accent);
      color: #FFFFFF;
    }
    body.dark .dest-btn.active {
      color: #0D1F18;
    }

    .trail-svg-wrap {
      width: 100%;
      height: 116px;
      background: #E2F2E7;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .trail-svg-wrap svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .outing-steps-5 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
    }
    @media (max-width: 620px) {
      .outing-steps-5 {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .step-btn {
      background: var(--surface);
      border: 1.5px solid var(--border);
      color: var(--text);
      border-radius: var(--radius-md);
      padding: 7px 6px;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .step-btn.done {
      background: var(--accent);
      color: #FFFFFF;
      border-color: var(--accent);
    }
    body.dark .step-btn.done {
      color: #0D1F18;
    }

    /* Start-to-Finish Sequence Picture Cards */
    .seq-progress-bar {
      width: 100%;
      height: 8px;
      background: var(--surface-soft);
      border: 1px solid var(--border);
      border-radius: var(--radius-pill);
      overflow: hidden;
    }

    .seq-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), #F59E0B);
      width: 0%;
      transition: width 0.25s ease;
    }

    .seq-cards-track {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      align-items: stretch;
    }

    @media (max-width: 580px) {
      .seq-cards-track {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .seq-pic-card {
      position: relative;
      background: #FFFDF8;
      border: 2px solid #28362F;
      border-radius: 14px;
      padding: 8px 7px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 5px;
      cursor: pointer;
      color: #14261E;
      box-shadow: 2px 2px 0 rgba(40, 54, 47, 0.16);
      transition: transform 0.14s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.2s ease;
      text-align: center;
    }

    .seq-pic-card:hover {
      transform: translateY(-2px);
    }

    .seq-pic-card:active {
      transform: scale(0.96);
    }

    .seq-pic-card.next-up {
      border-color: #0E8760;
      box-shadow: 0 0 0 3px rgba(14, 135, 96, 0.22);
    }

    .seq-pic-card.step-done {
      background: #D4F3E4;
      border-color: #0E8760;
    }

    .seq-pic-card.is-last {
      border-style: dashed;
      border-width: 2.2px;
    }

    .seq-pic-card.is-last.last-colored {
      border-style: solid;
      border-width: 2.5px;
      transform: scale(1.02);
      box-shadow: 0 6px 16px rgba(196, 104, 16, 0.25);
    }

    .seq-step-badge {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.68rem;
      font-weight: 800;
      color: #3B5246;
    }

    .seq-pic-card-svg {
      width: 92px;
      height: 58px;
    }

    .seq-pic-card-svg svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .seq-pic-card-label {
      font-size: 0.76rem;
      font-weight: 800;
      line-height: 1.2;
    }

    /* One-Tap Picture Cards Grid */
    .pic-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
      gap: 8px;
    }

    .pic-card {
      background: #FFFDF8;
      border: 2px solid #28362F;
      border-radius: 13px;
      padding: 7px 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      color: #14261E;
      box-shadow: 2px 2px 0 rgba(40, 54, 47, 0.14);
      transition: transform 0.12s ease, background 0.15s ease;
    }
    .pic-card:hover {
      transform: translateY(-2px);
      background: #F1FAF5;
    }
    .pic-card:active {
      transform: scale(0.96);
    }
    .pic-card.flash {
      background: #D4F3E4;
      border-color: #0E8760;
    }
    .pic-card-svg {
      width: 88px;
      height: 56px;
    }
    .pic-card-svg svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    .pic-card-label {
      font-size: 0.75rem;
      font-weight: 800;
      text-align: center;
      line-height: 1.2;
    }

    /* Day Task List */
    .task-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .task-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 8px 10px;
    }
    .task-row.done {
      opacity: 0.68;
      border-color: var(--accent);
    }

    .task-row.chain-task-row {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      opacity: 1;
    }

    .task-main {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      cursor: pointer;
    }

    .task-comic {
      width: 68px;
      height: 52px;
      background: #FFFDF8;
      border: 2px solid #28362F;
      border-radius: 10px;
      flex-shrink: 0;
      overflow: hidden;
    }
    .task-comic svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .task-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-pure);
      line-height: 1.25;
    }
    .task-row.done .task-title {
      text-decoration: line-through;
    }

    .mini-chain-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }
    @media (max-width: 540px) {
      .mini-chain-strip {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .del-btn {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 1rem;
      cursor: pointer;
      padding: 4px 6px;
    }

    /* =========================================================================
       8. TAB 2: TUKI (5 DECKS + 100 FACTS + STARTING TIMERS)
       ========================================================================= */
    .deck-card-stage {
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 150px;
      justify-content: center;
    }

    .deck-card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.76rem;
      font-weight: 800;
      color: var(--accent);
    }

    .deck-card-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-pure);
    }

    .deck-card-body {
      font-size: 0.9rem;
      color: var(--text);
      line-height: 1.55;
    }

    .starter-stage {
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }

    .starter-visuals {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .drop-chamber {
      width: 112px;
      height: 112px;
      border-radius: 50%;
      background: var(--blue-soft);
      border: 2px solid var(--blue);
      overflow: hidden;
    }
    .drop-chamber svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .spark-orb {
      width: 104px;
      height: 104px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #FDBA74 0%, #EA580C 68%, #9A3412 100%);
      color: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      box-shadow: 0 6px 20px rgba(234, 88, 12, 0.35);
      transition: transform 0.3s ease;
    }
    .spark-orb.running {
      animation: sparkPulse 0.95s ease-in-out infinite;
    }
    @keyframes sparkPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    /* =========================================================================
       9. TAB 3: TUNNE (PROGRESSIVE BREATHING SPHERE, RAIN, STIM BUBBLES, DIARY)
       ========================================================================= */
    .breath-stage {
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }

    .breath-arena {
      width: 176px;
      height: 176px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .breath-sphere {
      width: 116px;
      height: 116px;
      border-radius: 50%;
      background: radial-gradient(circle at 32% 28%, #F0F9FF 0%, #7DD3FC 42%, #0284C7 88%, #0369A1 100%);
      box-shadow:
        0 10px 28px rgba(2, 132, 199, 0.36),
        inset -5px -6px 14px rgba(3, 105, 161, 0.35),
        inset 6px 6px 15px rgba(255, 255, 255, 0.94);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #082F49;
      font-weight: 800;
      font-size: 0.94rem;
      line-height: 1.25;
      padding: 10px;
      transform: scale(0.82);
      transition-property: transform, box-shadow;
      transition-timing-function: ease-in-out;
      transition-duration: 4s;
    }

    .breath-sphere.inhale {
      transform: scale(1.26);
      box-shadow:
        0 18px 40px rgba(14, 165, 233, 0.55),
        inset -5px -6px 14px rgba(3, 105, 161, 0.25),
        inset 6px 6px 16px rgba(255, 255, 255, 0.98);
    }

    .breath-sphere.exhale {
      transform: scale(0.82);
      box-shadow:
        0 6px 18px rgba(2, 132, 199, 0.25),
        inset -5px -6px 14px rgba(3, 105, 161, 0.35),
        inset 5px 5px 14px rgba(255, 255, 255, 0.9);
    }

    /* Stim Bubbles */
    .stim-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      width: 100%;
      max-width: 380px;
      margin: 0 auto;
    }

    .stim-bubble {
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, var(--accent-soft) 60%, var(--accent) 100%);
      border: 2px solid var(--accent);
      cursor: pointer;
      transition: transform 0.14s ease, opacity 0.2s ease;
    }

    .stim-bubble.popped {
      transform: scale(0.82);
      background: var(--surface);
      border-color: var(--border);
      opacity: 0.55;
    }

    /* Emotion Diary */
    .mood-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }
    @media (max-width: 460px) {
      .mood-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .mood-btn {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      padding: 8px 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      cursor: pointer;
      color: var(--text);
    }
    .mood-btn.active {
      background: var(--accent-soft);
      border-color: var(--accent);
    }

    .stars-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      padding: 8px 12px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .star-btn {
      border: none;
      background: transparent;
      font-size: 1.45rem;
      cursor: pointer;
      filter: grayscale(100%) opacity(0.35);
      transition: transform 0.12s;
    }
    .star-btn.lit {
      filter: none;
      transform: scale(1.1);
    }

    .word-chip {
      background: var(--surface);
      border: 1.5px solid var(--border);
      color: var(--text);
      padding: 5px 10px;
      border-radius: var(--radius-pill);
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
    }
    .word-chip.active {
      background: var(--accent);
      color: #FFFFFF;
      border-color: var(--accent);
    }
    body.dark .word-chip.active {
      color: #0D1F18;
    }

    .canvas-wrap {
      width: 100%;
      height: 175px;
      background: #FFFFFF;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      touch-action: none;
      overflow: hidden;
    }
    #moodCanvas {
      width: 100%;
      height: 100%;
      display: block;
      cursor: crosshair;
    }

    .palette-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      background: var(--surface);
      padding: 7px 10px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .swatch {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 2px solid #FFFFFF;
      cursor: pointer;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    }
    .swatch.active {
      transform: scale(1.2);
      outline: 2px solid var(--text-pure);
    }
    .swatch-eraser {
      background: repeating-linear-gradient(45deg, #DCE7E1, #DCE7E1 3px, #FFFFFF 3px, #FFFFFF 6px);
    }

    .diary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 10px;
    }

    .diary-card {
      background: var(--surface-soft);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    /* =========================================================================
       10. TAB 4: TARINA (3 STAR GOALS, MEMORY DIARY, DREAM BOOK)
       ========================================================================= */
    .book-switcher {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      background: var(--surface-soft);
      padding: 4px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
    }

    .book-tab {
      border: none;
      background: transparent;
      padding: 8px 6px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 0.82rem;
      color: var(--text-muted);
      cursor: pointer;
    }
    .book-tab.active-memory {
      background: var(--amber-soft);
      color: var(--text-pure);
      border: 1px solid var(--amber);
    }
    .book-tab.active-dream {
      background: var(--purple-soft);
      color: var(--text-pure);
      border: 1px solid var(--purple);
    }

    .book-icon-btn {
      border: 1.5px solid var(--border);
      background: var(--surface);
      border-radius: 8px;
      padding: 4px 8px;
      font-size: 1.05rem;
      cursor: pointer;
    }
    .book-icon-btn.active {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .book-entry {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .book-entry.memory { border-left: 4px solid var(--amber); }
    .book-entry.dream { border-left: 4px solid var(--purple); }
    .book-entry.fulfilled { border-left-color: var(--accent); opacity: 0.88; }

    /* =========================================================================
       11. TAB 5: MAAILMA (REWARD WORLD DECORATOR & PETTING STAGE)
       ========================================================================= */
    .reward-rules-box {
      background: var(--amber-soft);
      border: 1.5px solid var(--amber);
      border-radius: var(--radius-lg);
      padding: 12px 14px;
      font-size: 0.84rem;
      color: var(--text-pure);
      line-height: 1.5;
    }

    .pet-interaction-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      background: var(--surface-tint);
      border: 1.5px solid var(--accent);
      border-radius: var(--radius-lg);
      padding: 10px 14px;
      flex-wrap: wrap;
    }

    .world-stage-frame {
      position: relative;
      width: 100%;
      height: 310px;
      border-radius: var(--radius-lg);
      border: 2px solid var(--border);
      overflow: hidden;
      background: #DDF2FA;
    }

    .world-stage-frame svg.stage-svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .stage-anim-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .stage-fish {
      position: absolute;
      display: inline-block;
      transform-origin: center;
      animation: stageSwim 16s linear infinite;
    }
    @keyframes stageSwim {
      0%   { left: -8%;  transform: scaleX(-1); }
      49%  { left: 102%; transform: scaleX(-1); }
      50%  { left: 102%; transform: scaleX(1); }
      99%  { left: -8%;  transform: scaleX(1); }
      100% { left: -8%;  transform: scaleX(-1); }
    }

    .stage-chicken {
      position: absolute;
      bottom: 14px;
      font-size: 1.8rem;
      display: inline-block;
      transform-origin: center;
      animation: stageChickenWalk 14s ease-in-out infinite;
    }
    @keyframes stageChickenWalk {
      0%   { left: 18%; transform: scaleX(-1); }
      48%  { left: 72%; transform: scaleX(-1); }
      50%  { left: 72%; transform: scaleX(1); }
      98%  { left: 18%; transform: scaleX(1); }
      100% { left: 18%; transform: scaleX(-1); }
    }

    .stage-goals-overlay {
      position: absolute;
      top: 8px;
      left: 8px;
      right: 8px;
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      justify-content: center;
      pointer-events: none;
    }

    .stage-goal-pill {
      background: rgba(255, 253, 238, 0.94);
      border: 1.5px solid #D97706;
      color: #291D05;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      font-size: 0.72rem;
      font-weight: 800;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    }

    .shop-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .shop-chip {
      background: var(--surface);
      border: 1.5px solid var(--border);
      color: var(--text);
      padding: 6px 10px;
      border-radius: var(--radius-md);
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .shop-chip:hover:not(:disabled) {
      border-color: var(--accent);
      background: var(--accent-soft);
    }
    .shop-chip.owned {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--text-pure);
      cursor: default;
    }

    /* =========================================================================
       12. PERSISTENT BOTTOM-RIGHT COMPANION CUSHION
       ========================================================================= */
    .corner-pet {
      position: fixed;
      bottom: 12px;
      right: 12px;
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      user-select: none;
    }

    .pet-speech-tag {
      background: var(--surface);
      color: var(--text-pure);
      border: 1.5px solid var(--border);
      padding: 4px 11px;
      border-radius: var(--radius-pill);
      font-size: 0.74rem;
      font-weight: 800;
      margin-bottom: 4px;
      box-shadow: var(--shadow);
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .pet-pad {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 24px;
      padding: 6px 12px 3px;
      box-shadow: var(--shadow);
      width: 90px;
      height: 74px;
    }
    .pet-pad svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .pet-head { transform-origin: 48px 42px; animation: idleHead 6s ease-in-out infinite; }
    @keyframes idleHead { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }

    .pet-tail { transform-origin: 65px 68px; animation: idleTail 3.2s ease-in-out infinite; }
    @keyframes idleTail { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(7deg); } }

    .pet-wagging .pet-tail {
      animation: joyfulWag 0.26s ease-in-out infinite !important;
    }
    .pet-wagging .pet-head {
      animation: joyfulBounce 0.45s ease-in-out infinite !important;
    }
    @keyframes joyfulWag {
      0%, 100% { transform: rotate(-25deg); }
      50% { transform: rotate(30deg); }
    }
    @keyframes joyfulBounce {
      0%, 100% { transform: translateY(0) rotate(-5deg); }
      50% { transform: translateY(-3px) rotate(5deg); }
    }

    .pet-sleeping .pet-head { animation: none; transform: translateY(4px) rotate(4deg); }
    .pet-sleeping .pet-tail { animation: none; transform: rotate(-10deg); }

    /* =========================================================================
       13. SETTINGS MODAL, TOAST & FLOATING COINS
       ========================================================================= */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 25, 18, 0.5);
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 60;
    }
    .modal-backdrop.open { display: flex; }

    .modal-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 20px;
      width: 100%;
      max-width: 390px;
      display: flex;
      flex-direction: column;
      gap: 13px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
    }

    .setting-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
      font-weight: 700;
    }

    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--text-pure);
      color: var(--surface);
      padding: 9px 18px;
      border-radius: var(--radius-pill);
      font-size: 0.84rem;
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transition: 0.25s ease;
      z-index: 90;
      text-align: center;
      max-width: 90%;
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .floating-coin {
      position: fixed;
      pointer-events: none;
      z-index: 95;
      animation: floatCoinUp 0.95s ease-out forwards;
    }
    @keyframes floatCoinUp {
      0% { opacity: 1; transform: translate(-50%, 0) scale(0.95); }
      100% { opacity: 0; transform: translate(-50%, -40px) scale(1.15); }
    }
  </style>
</head>
<body>
  <!-- PERSISTENT BOTTOM-RIGHT COMPANION CUSHION -->
  <div class="corner-pet" id="cornerPet" title="Silittele kaveria"></div>

  <div class="app">
    <!-- ===================================================================
         1. SINGLE-ROW ROUNDED PILL HEADER
