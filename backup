      const level = Math.floor((state.totalEarned || 0) / 100) + 1;
      document.getElementById("pointsCount").textContent = state.points;
      document.getElementById("levelCount").textContent = level;
    }

    function addPoints(amount, reason, e) {
      if (amount <= 0) return;
      state.points += amount;
      state.totalEarned = (state.totalEarned || 0) + amount;
      saveState();
      updatePointsAndLevelUI();

      const badge = document.getElementById("pointsBadge");
      badge.classList.add("pop");
      setTimeout(() => badge.classList.remove("pop"), 200);

      if (amount < 10) {
        playTone(660, 0.11);
        spawnFloatingCoin(amount, e);
      } else {
        playTone(580, 0.18);
        setTimeout(() => playTone(760, 0.22), 100);
        spawnFloatingCoin(amount, e);
        if (reason) showToast(reason, amount);
      }
      wakePetCalmly();
    }

