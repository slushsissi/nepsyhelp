      { title: "39. Viivästynyt unirytmi", text: "Monilla ADHD-ihmisillä melatoniinin eritys alkaa hieman myöhemmin. Rauhalliset iltarutiinit auttavat kehoa laskeutumaan uneen." },
      { title: "40. Kirjoittaminen tyhjentää pään", text: "Kun mielessä pyörivät asiat siirtää ylös, työmuisti vapautuu hengittämään." },
      { title: "41. Pienet palkinnot vahvistavat tapoja", text: "Aivot oppivat uusia rutiineja parhaiten onnistumisen kokemusten kautta." },
      { title: "42. Ensimmäisen liikkeen mielikuva", text: "Älä ajattele koko lenkkiä – ajattele vain sukkien laittamista jalkaan." },
      { title: "43. Tunteiden nimeäminen rauhoittaa", text: "Kun tunteelle löytää hymiön, värin tai sanan, hermoston hälytystila alkaa laskea." },
      { title: "44. Erilaiset aivot täydentävät toisiaan", text: "Ihmiskunta tarvitsee sekä rutiineja ylläpitäviä että uusia polkuja tutkivia aivoja." },
      { title: "45. Katse horisonttiin lepuuttaa", text: "Ruudun katsomisen jälkeen kauas ikkunasta katsominen rentouttaa silmiä ja hermostoa." },
      { title: "46. Tehtävälista on apuväline", text: "Listalta saa myös poistaa asioita, jos huomaat ettet jaksa niitä tänään." },
      { title: "47. Liike vapauttaa keskittymisainetta", text: "Pieni venyttely tai kävely nostaa dopamiini- ja noradrenaliinitasoja luonnollisesti." },
      { title: "48. Unohdukset ovat inhimillisiä", text: "Avainten tai puhelimen unohtuminen johtuu työmuistin kuormituksesta, ei välinpitämättömyydestä." },
      { title: "49. Ympäristön muokkaaminen", text: "Avaimet kulhoon oven viereen ja vesipullo pöydälle tekevät arjesta sujuvampaa." },
      { title: "50. Hiljainen yhdessäolo", text: "Ystävän kanssa voi viettää aikaa samassa tilassa myös puhumatta, kumpikin omissa puuhissaan." },
      { title: "51. Aistien lepohetki päivällä", text: "Viisi minuuttia silmät kiinni hämärässä huoneessa palauttaa yllättävän paljon voimia." },
      { title: "52. Kysymys: Mikä helpottaisi tätä?", text: "Sen sijaan että pakotat itsesi, kysy: voinko laittaa kuulokkeet päähän tai jakaa tämän kahteen osaan?" },
      { title: "53. Värit auttavat hahmottamaan", text: "Värikoodit ja selkeät symbolit auttavat aivoja jäsentämään viikkoa ja tunteita." },
      { title: "54. Empatia näkyy tekoina", text: "Autisminkirjolla välittäminen näkyy usein käytännön apuna, uskollisuutena ja tarkkana huomioimisena." },
      { title: "55. Yksi asia kerrallaan riittää", text: "Moniajo kuluttaa aivoja nopeasti. Yksi pieni askel vie varmemmin perille." },
      { title: "56. Puhdas pöytäkulma", text: "Kun edes pieni alue pöydästä on tyhjä, aivojen ei tarvitse käsitellä visuaalista hälyä." },
      { title: "57. Hyvien muistojen merkitys", text: "Muistelupäiväkirjan lukeminen muistuttaa, kuinka monesta tilanteesta olet jo selvinnyt." },
      { title: "58. Lämpö rentouttaa hartiat", text: "Lämmin suihku, villasukat tai kuppi teetä viestittää keholle, että voit levätä." },
      { title: "59. Omat rajat suojaavat jaksamista", text: "Ei-sanan sanominen kuormittavalle menolle on kyllä-sana omalle palautumiselle." },
      { title: "60. Keskittyminen aaltoilee", text: "Ajatusten harhailu on luonnollista – huomaa se ja palaa takaisin yhteen pieneen askeleeseen." },
      { title: "61. Tavoitteiden pilkkominen", text: "Iso haave muuttuu todeksi, kun sen rinnalla on tämän päivän kokoinen pieni teko." },
      { title: "62. Äänimaailman hallinta", text: "Vastamelukuulokkeet tai korvatulpat kaupassa suojaavat hermostoa äkillisiltä ääniltä." },
      { title: "63. Tarpeet ovat oikeutettuja", text: "Tarve tauolle, hiljaisuudelle tai selkeille ohjeille on yhtä luonnollinen kuin tarve silmälaseille." },
